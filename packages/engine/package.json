{
  "name": "@monospace-timetable/engine",
  "version": "0.1.0",
  "description": "The timetable engine and .xlsx writer from Monospace, portable to Node and the browser from one source.",
  "license": "AGPL-3.0-only",
  "author": "Cam Wooloo",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "fixtures",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stream": {
      "types": "./dist/workbook/stream.d.ts",
      "browser": "./dist/workbook/stream.browser.js",
      "default": "./dist/workbook/stream.js"
    },
    "./browser-shims": {
      "types": "./dist/browser/shims.d.ts",
      "default": "./dist/browser/shims.js"
    },
    "./package.json": "./package.json"
  },
  "browser": {
    "./dist/workbook/stream.js": "./dist/workbook/stream.browser.js",
    "./src/workbook/stream.ts": "./src/workbook/stream.browser.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --import tsx scripts/fix-esm-extensions.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:refresh": "node --import tsx --import ./scripts/register-hooks.mjs scripts/refresh-fixtures.ts",
    "build:browser": "node --import tsx scripts/build-browser.ts"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "readable-stream": "^3.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/readable-stream": "^2.3.15",
    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "constants-browserify": "^1.0.0",
    "create-hash": "^1.2.0",
    "esbuild": "^0.24.2",
    "events": "^3.3.0",
    "path-browserify": "^1.0.1",
    "randombytes": "^2.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "util": "^0.12.5",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
